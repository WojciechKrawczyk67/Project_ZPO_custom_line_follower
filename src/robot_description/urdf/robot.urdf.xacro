<?xml version="1.0"?>

<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find robot_description)/urdf/wheels.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/robot.ros2_control.xacro"/>

  <material name="rover_white">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <link name="base_footprint">
  </link>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 3.1416 1.57079632679"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/baza.STL"/>
      </geometry>
      <material name="rover_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 3.1416 1.57079632679"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/baza.STL"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 3.1416 1.57079632679"/>
      <mass value="4.38"/>
      <inertia ixx="0.059" ixy="0" ixz="0" iyy="0.034" iyz="0" izz="0.09"/>
    </inertial>
  </link>


  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
  </joint>

  

  <link name="back_link">
    <visual>
      <origin xyz="0 0 0" rpy="${3*pi/2} ${pi} ${pi/2}"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/back.STL"/>
      </geometry>
      <material name="rover_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${3*pi/2} ${pi} ${pi/2}"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/back.STL"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.04 0" rpy="${3*pi/2} ${pi} ${pi/2}"/>
      <mass value="7.1"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.06"/>
    </inertial>
  </link>


  <joint name="back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_link"/>
    <origin xyz="-0.18 0 -0.14" rpy="0 0 0"/>
  </joint>

  <link name="stojak_link">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} ${pi} ${3*pi/2}"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/stojak.STL"/>
      </geometry>
      <material name="rover_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} ${pi} ${3*pi/2}"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/stojak.STL"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.0 0" rpy="${pi/2} ${pi} ${3*pi/2}"/>
      <mass value="0.06"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>


  <joint name="stojak_joint" type="fixed">
    <parent link="base_link"/>
    <child link="stojak_link"/>
    <origin xyz="0.19 0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 ${3*pi/4} 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/camera.STL"/>
      </geometry>
      <material name="rover_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 ${3*pi/4} 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/camera.STL"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.0 0" rpy="0 ${3*pi/4} 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>


  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.21354 0 0.02222" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${1*pi/4} ${pi} ${pi/2}"/>
  </joint>

  <gazebo reference="camera_optical_link">
    <sensor type="camera" name="line_camera_sensor"> 
      <always_on>true</always_on>
      <update_rate>60.0</update_rate>
      <camera>
        <horizontal_fov>${0.4*pi}</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>2.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <link name="steer_left_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi} 0 0"/>
        <geometry>
          <mesh filename="package://robot_description/meshes/skret.STL"/>
        </geometry>
        <material name="rover_white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi} 0 0"/>
        <geometry>
          <mesh filename="package://robot_description/meshes/skret.STL"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.04" rpy="${pi} 0 0"/>
        <mass value="0.95"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
  </link>

  <joint name="steer_left_joint" type="revolute">
    <parent link="base_link"/>
    <child link="steer_left_link"/>
    <origin xyz="0.18 0.13 -0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> 
    <limit lower="-0.9" upper="0.9" effort="45.0" velocity="3.0"/>
  </joint>

  <link name="steer_right_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi} 0 0"/>
        <geometry>
          <mesh filename="package://robot_description/meshes/skret.STL"/>
        </geometry>
        <material name="rover_white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi} 0 0"/>
        <geometry>
          <mesh filename="package://robot_description/meshes/skret.STL"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.04" rpy="${pi} 0 0"/>
        <mass value="0.95"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
  </link>

  <joint name="steer_right_joint" type="revolute">
    <parent link="base_link"/>
    <child link="steer_right_link"/>
    <origin xyz="0.18 -0.13 -0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> 
    <limit lower="-0.9" upper="0.9" effort="45.0" velocity="3.0"/>
  </joint>
















  
  <xacro:rover_wheel prefix="bl" parent_link="base_link">
    <origin xyz="-0.18 0.162 -0.14" rpy="0 0 0"/>
  </xacro:rover_wheel>
  <xacro:rover_wheel prefix="br" parent_link="base_link">
    <origin xyz="-0.18 -0.162 -0.14" rpy="0 0 0"/>
  </xacro:rover_wheel>

  <link name="fl_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <mesh filename="package://robot_description/meshes/kolo.STL"/>
        </geometry>
        <material name="rover_white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.06" length="0.02"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <mass value="4.03"/>
        <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.007"/>
    </inertial>
  </link>

  <link name="fr_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <mesh filename="package://robot_description/meshes/kolo.STL"/>
        </geometry>
        <material name="rover_white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.06" length="0.02"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <mass value="4.03"/>
        <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.007"/>
    </inertial>
  </link>


  <joint name="fr_wheel_joint" type="continuous">
    <parent link="steer_right_link"/>
    <child link="fr_wheel_link"/>
    <origin xyz="0 -0.032 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.0001" velocity="50.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <joint name="fl_wheel_joint" type="continuous">
    <parent link="steer_left_link"/>
    <child link="fl_wheel_link"/>
    <origin xyz="0 0.032 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.0001" velocity="50.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <xacro:robot_ros2_control/>

  



  
</robot>